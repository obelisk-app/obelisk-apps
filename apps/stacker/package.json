{
  "name": "@obelisk/app-stacker",
  "version": "1.0.0",
  "private": true,
  "description": "Stacker for Obelisk Apps: real-time falling-block battles",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node ../../scripts/build-app.mjs ."
  },
  "dependencies": {
    "@obelisk/apps-sdk": "*",
    "@obelisk/apps-ui": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "jsdom": "^25.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3"
  },
  "obelisk": {
    "slug": "stacker",
    "title": "Stacker",
    "types": [
      "game"
    ],
    "players": [
      1,
      6
    ],
    "realtime": true,
    "content": "Real-time falling-block battles: everyone plays at once, cleared lines send garbage to opponents, last board standing wins."
  }
}

# frame.obelisk.ar: Obelisk Apps sandbox frame loader (obelisk-apps/packages/frame).
# Stranger code runs under this origin (opaque, sandboxed); keep it free of any
# login session and never serve anything else here.
:8101 {
	bind 127.0.0.1
	root * /root/obelisk-apps/packages/frame/public
	file_server
	encode gzip
	redir / /v1/ 302
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self' blob: 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' blob:; img-src data: blob:; media-src data: blob:; font-src data: blob:; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors https://obelisk.ar https://dex.obelisk.ar https://test.obelisk.ar https://games.obelisk.ar tauri://localhost http://tauri.localhost http://localhost:3000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cross-Origin-Resource-Policy cross-origin
		# The page runs sandboxed (origin "null"), and browsers fetch its
		# module script in CORS mode: without this, loader.js is blocked and
		# the frame stays blank. Public static files, nothing to protect.
		Access-Control-Allow-Origin *
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=()"
		# no-store, not no-cache: Cloudflare kept serving a cached loader.js with
		# stale headers after a revalidation. These files are tiny; never edge-cache them.
		Cache-Control "no-store"
		-Server
	}
}

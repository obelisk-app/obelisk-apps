    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "nostr-tools": "^2.15.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}

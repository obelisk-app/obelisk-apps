{
  "name": "@obelisk/blossom",
  "version": "0.1.0",
  "private": true,
  "description": "Blossom server for Obelisk app bundles, with obelisk-relay-style WoT upload admission",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
